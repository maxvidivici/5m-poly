# =============================================================
# edge-bot configuration (copy to .env and fill in)
# =============================================================

# --- Mode ---
# paper: live data, simulated orders, full journal (default)
# live:  real orders via Polymarket CLOB
# backtest: replay historical 5m windows
EDGE_MODE=paper
# Required only for EDGE_MODE=live. This deliberate friction prevents accidental real-money orders.
LIVE_TRADING_ACK=

# --- Polymarket endpoints ---
GAMMA_BASE_URL=https://gamma-api.polymarket.com
PM_CLOB_BASE=https://clob.polymarket.com
PM_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PM_CLOB_WS_ENABLED=true          # observation only; does not affect entries

# --- Polymarket auth (required for EDGE_MODE=live) ---
PM_PRIVATE_KEY=
PM_FUNDER=
PM_SIGNATURE_TYPE=2
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# --- Market & symbol ---
SYMBOL=BTC
MARKET_KIND=btc-updown-5m

# --- Price feed ---
# Current BTC 5m markets resolve from Chainlink BTC/USD data streams.
# Spot feeds are signal inputs / paper approximations, not the official resolver.
REQUIRED_RESOLUTION_SOURCE=chainlink
PRIMARY_PRICE_SOURCE=coinbase
FALLBACK_PRICE_SOURCES=binance,kraken
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
PRICE_STALENESS_MAX_SEC=4

# --- Entry filters (composite signal) ---
WINDOW_DELTA_USD_MIN=70.0         # hard trigger from the original strategy
WINDOW_DELTA_USD_SOFT_MIN=55.0    # near-miss zone; requires stronger CLOB confirmation
WINDOW_DELTA_USD_STRONG=120.0
ADAPTIVE_DELTA_ENABLED=true       # ATR-based floating BTC move threshold
ADAPTIVE_DELTA_ATR_MULT=0.35
ADAPTIVE_DELTA_HARD_MIN=65.0
ADAPTIVE_DELTA_HARD_MAX=100.0
ADAPTIVE_DELTA_SOFT_RATIO=0.82
ENTRY_SECONDS_LEFT_MAX=120        # don't enter earlier than 2 min before close
ENTRY_SECONDS_LEFT_MIN=10         # don't enter later than 10s before close
CLOB_ASK_MIN=0.68                 # market must already lean our way
SOFT_DELTA_CLOB_ASK_MIN=0.70      # required when BTC move is below hard $70 trigger
CLOB_ASK_MAX=0.95                 # avoid almost-resolved / badly priced entries
MIN_CONFIDENCE=0.62
ZSCORE_MAX=2.5                    # soft z-score penalty starts here, not a hard block
ATR_SCORE_MIN_PCT=0.06            # 5m ATR% normal zone lower bound
ATR_SCORE_MAX_PCT=0.22            # 5m ATR% normal zone upper bound
ATR_SCORE_HIGH_PCT=0.35           # above this ATR% confidence is penalized
ATR_HARD_BLOCK_ENABLED=true       # block entries in extreme 5m volatility
ATR_HARD_BLOCK_PCT=0.30           # atr_pct >= 0.30% skips entry
HIGH_VOL_EDGE_GUARD_ENABLED=true  # in high volatility, require stronger delta/zscore edge
HIGH_VOL_EDGE_GUARD_ATR_PCT=0.22
HIGH_VOL_MIN_DELTA_STRONG_RATIO=0.80
HIGH_VOL_MIN_ABS_ZSCORE=0.50
RSI_MAX=78
RSI_MIN=22
ATR_OVERHEAT_MULT=1.6             # current range > 1.6x ATR -> soft confidence penalty
SPREAD_MAX=0.03
TOP_ASK_NOTIONAL_USD_MIN=20
CONSENSUS_GUARD_MIN=0.35          # never bet AGAINST market price below this

# --- Risk manager ---
START_EQUITY_USD=100.0
MAX_POSITION_PCT=3.0              # per-entry cap; market cap below limits stacking
KELLY_FRACTION=0.35
MIN_POSITION_USD=1.0
MAX_POSITION_USD=15.0
MIN_PROBABILITY_EDGE=0.02         # confidence must beat entry ask by at least 2 percentage points
ALLOW_MULTIPLE_ENTRIES_PER_MARKET=true
MAX_ENTRIES_PER_MARKET=2          # normal main entry is still one; second slot is ADD_ON only
MAX_MARKET_EXPOSURE_PCT=7.5       # total exposure in one 5m market, across re-entries
MIN_REENTRY_DELAY_SEC=15
ADD_ON_ENABLED=true
ADD_ON_SIZE_USD=3.0               # capped by base entry size
ADD_ON_MIN_SECONDS_LEFT=45
ADD_ON_MIN_SIDE_ASK=0.82
ADD_ON_MIN_DELTA_STRONG_RATIO=1.00
ADD_ON_MIN_ABS_ZSCORE=1.00
ADD_ON_MAX_SPREAD=0.02
DAILY_LOSS_CAP_PCT=5.0
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_AFTER_LOSSES_SEC=900
MAX_TRADES_PER_HOUR=8
MAX_TRADES_PER_DAY=60
MIN_BALANCE_USD=30.0

# --- Hedge engine ---
HEDGE_ENABLED=true
HEDGE_SKEW_TRIGGER=0.95
HEDGE_SECONDS_LEFT_MAX=30
HEDGE_MIN_MAIN_NOTIONAL_USD=25
HEDGE_ONCE_PER_MARKET=true
HEDGE_NOTIONAL_PCT_OF_MAIN=3.0
HEDGE_NOTIONAL_USD_MIN=1.0
HEDGE_NOTIONAL_USD_MAX=2.0

# --- Paper/live fee model ---
PAPER_TAKER_FEES_ENABLED=true
PAPER_TAKER_FEE_RATE=0.07

# --- Live-readiness fill simulation ---
FILL_SIM_TARGETS_USD=10,25,50,100
ORDERBOOK_SNAPSHOT_LEVELS=10
LIVE_MAX_FILL_SLIPPAGE=0.02
LIVE_MIN_FILL_RATIO=0.50
LIVE_MAX_AVG_FILL_PRICE=0.92

# --- Exit management ---
STOP_LOSS_PCT=0.25
TAKE_PROFIT_PCT=0.20
TRAIL_ARM_PCT=0.12
TRAIL_GIVEBACK_PCT=0.06
EXIT_BEFORE_SEC=20
PAPER_SETTLE_ON_EXPIRY=true
CLOSE_RETRY_MAX=10
CLOSE_RETRY_DELAY_SEC=2.0

# --- Telegram reports ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_INTERVAL_SEC=900  # 15 minutes
TELEGRAM_SEND_ON_START=true
TELEGRAM_TIMEOUT_SEC=10
# --- Storage ---
RUNTIME_DIR=runtime
JOURNAL_DB=runtime/journal.sqlite3
AUDIT_LOG=runtime/audit.jsonl
DASHBOARD_PATH=runtime/dashboard.txt

# --- Operations ---
LOOP_POLL_SEC=1.0
HEARTBEAT_INTERVAL_SEC=5
HEALTH_PORT=8080
DASHBOARD_REFRESH_SEC=5
LOG_LEVEL=INFO
